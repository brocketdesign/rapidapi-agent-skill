  "openapi": {
    "openapi": "3.0.3",
    "info": {
      "title": "My API Name",
      "description": "Same as long_description above.",
      "version": "1.0.0",
      "contact": {
        "name": "brocketdesign",
        "url": "https://rapidapi.com/brocketdesign"
      }
    },
    "servers": [
      {
        "url": "https://YOUR-APP.up.railway.app",
        "description": "Production"
      }
    ],
    "security": [
      { "RapidAPIKey": [] }
    ],
    "paths": {
      "/health": {
        "get": {
          "summary": "Health check",
          "operationId": "health",
          "responses": {
            "200": {
              "description": "Server is healthy",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "status": { "type": "string", "example": "ok" },
                      "version": { "type": "string", "example": "1.0.0" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "/endpoint": {
        "get": {
          "summary": "Main endpoint",
          "description": "Describe what this endpoint does.",
          "operationId": "endpoint",
          "parameters": [
            {
              "name": "q",
              "in": "query",
              "required": true,
              "description": "Input query",
              "schema": { "type": "string", "example": "hello world" }
            }
          ],
          "responses": {
            "200": {
              "description": "Successful response",
              "content": {
                "application/json": {
                  "schema": { "$ref": "#/components/schemas/SuccessResponse" }
                }
              }
            },
            "400": {
              "description": "Bad request",
              "content": {
                "application/json": {
                  "schema": { "$ref": "#/components/schemas/Error" }
                }
              }
            },
            "403": {
              "description": "Forbidden — invalid or missing API key",
              "content": {
                "application/json": {
                  "schema": { "$ref": "#/components/schemas/Error" }
                }
              }
            },
            "429": {
              "description": "Rate limit exceeded",
              "content": {
                "application/json": {
                  "schema": { "$ref": "#/components/schemas/Error" }
                }
              }
            }
          }
        }
      }
    },
    "components": {
      "securitySchemes": {
        "RapidAPIKey": {
          "type": "apiKey",
          "in": "header",
          "name": "X-RapidAPI-Key"
        }
      },
      "schemas": {
        "SuccessResponse": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "example": "success" },
            "data": { "type": "object" },
            "cached": { "type": "boolean", "example": false }
          }
        },
        "Error": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "example": "error" },
            "message": { "type": "string", "example": "The 'q' parameter is required" }
          }
        }
      }
    }
  }
}
